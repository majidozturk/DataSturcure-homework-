class Node:
    def __init__(self, data):
        self.data = data
        self.prev = None
        self.next = None

class DoublyLinkedList:
    def __init__(self):
        self.head = None

    def delete_at_beginning(self):
        if self.head is None:
            print("List is empty!")
            return
        
        if self.head.next is None: # Only one node exists
            self.head = None
        else:
            self.head = self.head.next
            self.head.prev = None

    def delete_at_end(self):
        if self.head is None:
            print("List is empty!")
            return
        
        curr = self.head
        if curr.next is None: # Only one node exists
            self.head = None
            return

        while curr.next: # Traverse to the last node
            curr = curr.next
        
        curr.prev.next = None # Disconnect the last node

    def delete_node(self, key):
        curr = self.head
        
        while curr:
            if curr.data == key:
                if curr == self.head:
                    self.delete_at_beginning()
                
                elif curr.next is None:
                    self.delete_at_end()
              
                else:
                    curr.prev.next = curr.next
                    curr.next.prev = curr.prev
                return
            curr = curr.next
        print("Node not found!")
