# Adding Elements (Insertion)

numbers = [1, 2, 3]
numbers.append(4)

# Adds element at a specific position

numbers = [1, 2, 4]
numbers.insert(2, 3) 

#Appends multiple elements

numbers = [1, 2]
numbers.extend([3, 4])

# Removing Elements (Deletion)

colors = ["red", "blue", "red"]
colors.remove("red") 

# Removes the element at the given index

numbers = [10, 20, 30]
last_item = numbers.pop() # Removes 30
first_item = numbers.pop(0) # Removes 10

# Used to delete an item at a specific index

numbers = [0, 1, 2, 3, 4, 5]
del numbers[0]     # Removes index 0 -> [1, 2, 3, 4, 5]
del numbers[1:3]   # Removes index 1 and 2 -> [1, 4, 5]

#Removes all elements from the list

numbers = [1, 2, 3]
numbers.clear()
