class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

class CircularLinkedList:
    def __init__(self):
        self.head = None

    def traverse(self):
        if not self.head:
            print("The list is empty.")
            return

        temp = self.head
        print("Nodes in the circular linked list:")
        
        while True:
            print(temp.data, end=" -> ")
            temp = temp.next
            
            if temp == self.head:
                break
        print("(back to head)")

cll = CircularLinkedList()
