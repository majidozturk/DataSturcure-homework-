import heapq

data = [10, 2, 15, 6, 4]

heapq.heapify(data) 
print("Min Heap:", data) # Root (index 0) will be 2

max_heap = []
for x in [10, 2, 15, 6, 4]:
    heapq.heappush(max_heap, -x)

print("Max element:", -heapq.heappop(max_heap)) # Returns 15
